# Ignore WordPress core — only the child theme is tracked
/wp-admin/
/wp-includes/
/wp-*.php
/xmlrpc.php
/index.php
/license.txt
/readme.html

# WP config (contains DB credentials)
wp-config.php
wp-config-local.php

# Ignore all themes and plugins EXCEPT our child theme.
# NOTE the trailing /* on themes — excluding the directory itself
# (/wp-content/themes/) stops git descending into it, so the negation
# below can never match and the child theme silently goes untracked.
/wp-content/plugins/
/wp-content/themes/*
!/wp-content/themes/nsfc-child/

# Ignore uploads
/wp-content/uploads/

# Ignore vendor (Composer managed)
/vendor/

# DDEV — config.yaml IS tracked so a fresh clone can `ddev start`.
# DDEV maintains its own .ddev/.gitignore for the generated files it creates
# (db_snapshots, *.local.yaml, image build dirs), so nothing extra is needed here.

# macOS
.DS_Store
